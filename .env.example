# Copy this file to .env and fill in the values

# Flask - Paste any long random text here
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database - Leave as is
DATABASE_URL=sqlite:///study_planner.db

# Google Calendar (OPTIONAL - only fill if you want to use Google Calendar)
# Setup guide: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
