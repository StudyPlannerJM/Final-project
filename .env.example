# Copy this file to .env and fill in the values

# Flask - Paste any long random text here
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database - Leave as is
DATABASE_URL=sqlite:///complete_study_planner.db

# Server URL (IMPORTANT for OAuth)
# For local development: http://localhost:5000 or http://127.0.0.1:5000
# For production: https://yourdomain.com (must match Google OAuth settings)
SERVER_URL=http://localhost:5000

# Google Calendar (OPTIONAL - only fill if you want to use Google Calendar)
# Setup guide: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI (for AI Study Plan Generator)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ApyHub API (for Document Summarizer)
# Get your free API key at: https://apyhub.com/
APYHUB_API_KEY=your_apyhub_api_key_here